{
  "name": "crawlora/rednote",
  "description": "Crawlora RedNote API client with 4 endpoints for public explore feeds, note details, comments, and search suggestions",
  "keywords": [
    "crawlora",
    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "rednote",
    "rednote-api",
    "rednote-scraper",
    "rednote-data",
    "rednote-public-explore-feeds",
    "rednote-note-details",
    "rednote-comments",
    "rednote-search-suggestions"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Rednote\\": "src/Crawlora/Rednote/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Rednote\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=rednote-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-rednote",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=rednote-php-api-docs"
  }
}
