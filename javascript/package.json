{
  "name": "@crawlora-org/rednote",
  "version": "0.1.0",
  "description": "Crawlora RedNote API client with 4 endpoints for public explore feeds, note details, comments, and search suggestions",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=rednote-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-rednote/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "rednote", "rednote-api", "rednote-scraper", "rednote-data", "rednote-public-explore-feeds", "rednote-note-details", "rednote-comments", "rednote-search-suggestions"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-rednote",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
